[node name="下下周条" type="PanelContainer" parent="边框/内容/滚动/边距/列表"]
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"WeekAfter"

[node name="内容" type="VBoxContainer" parent="边框/内容/滚动/边距/列表/下下周条"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="下下周" type="Label" parent="边框/内容/滚动/边距/列表/下下周条/内容"]
layout_mode = 2
