[node name="条目" type="VBoxContainer" parent="边框/内容/滚动/边距/列表/下下周条/内容"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="更远条" type="PanelContainer" parent="边框/内容/滚动/边距/列表"]
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"WeekLater"

[node name="内容" type="VBoxContainer" parent="边框/内容/滚动/边距/列表/更远条"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="更远" type="Label" parent="边框/内容/滚动/边距/列表/更远条/内容"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"SectionTitle"
text = "更远"

[node name="更远说明" type="Label" parent="边框/内容/滚动/边距/列表/更远条/内容"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PauseNote"
theme_override_font_sizes/font_size = 13
text = "您的一般周提醒不会在这里显示的哦"
autowrap_mode = 3

[node name="条目" type="VBoxContainer" parent="边框/内容/滚动/边距/列表/更远条/内容"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="已完成" type="Label" parent="边框/内容/滚动/边距/列表"]
visible = false
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "已完成"

[node name="添加行" type="VBoxContainer" parent="边框/内容"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -104.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 8

[node name="隐藏" type="Button" parent="边框/内容/添加行"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DayButton"
text = "隐藏每周日常提醒"

[node name="动作" type="HBoxContainer" parent="边框/内容/添加行"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 8

[node name="添加" type="Button" parent="边框/内容/添加行/动作"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"OkButton"
text = "+ 添加"

[node name="删除" type="Button" parent="边框/内容/添加行/动作"]
visible = false
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DeleteButton"
text = "删除"

[node name="撤销" type="Button" parent="边框/内容/添加行/动作"]
visible = false
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SkipButton"
text = "撤销"

