[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/once_page.gd" id="1_page"]
[ext_resource type="PackedScene" path="res://scenes/once_day.tscn" id="2_day"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_agenda_frame"]
bg_color = Color(1, 1, 1, 1)
border_color = Color(0.372549, 0.576471, 0.721569, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5
corner_detail = 5

[node name="行程" type="Control"]
clip_contents = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_page")

[node name="边框" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"AlarmFrame"
theme_override_styles/panel = SubResource("StyleBoxFlat_agenda_frame")

[node name="内容" type="Control" parent="边框"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2

[node name="滚动" type="ScrollContainer" parent="边框/内容"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="边距" type="MarginContainer" parent="边框/内容/滚动"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
mouse_filter = 2
theme_override_constants/margin_bottom = 116

[node name="列表" type="VBoxContainer" parent="边框/内容/滚动/边距"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 0

[node name="空提示" type="Label" parent="边框/内容/滚动/边距/列表"]
layout_mode = 2
theme_type_variation = &"PauseNote"
text = "还没有行程。点 + 加一个只响一次的提醒。"
horizontal_alignment = 1
autowrap_mode = 3

[node name="本周条" type="PanelContainer" parent="边框/内容/滚动/边距/列表"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"WeekThis"

[node name="内容" type="VBoxContainer" parent="边框/内容/滚动/边距/列表/本周条"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="本周" type="Label" parent="边框/内容/滚动/边距/列表/本周条/内容"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"SectionTitle"
text = "本周"

[node name="无提醒" type="Label" parent="边框/内容/滚动/边距/列表/本周条/内容"]
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PauseNote"
text = "此周无提醒"

[node name="本周天" type="VBoxContainer" parent="边框/内容/滚动/边距/列表/本周条/内容"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

