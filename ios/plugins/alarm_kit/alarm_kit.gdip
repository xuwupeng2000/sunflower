[config]

name="AlarmKit"
binary="alarm_kit.xcframework"
initialization="alarm_kit_init"
deinitialization="alarm_kit_deinit"

[dependencies]

linked=[]
embedded=["SunflowerShared.xcframework"]
system=["AlarmKit.framework", "ActivityKit.framework", "AppIntents.framework", "SwiftUI.framework"]
files=["sunflower.wav"]

[plist]

NSAlarmKitUsageDescription="用向日葵闹钟在你设定的时间叫醒你。"
